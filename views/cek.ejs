<%- include('_head', { title: 'Cek Tiket' }) %>
<h1 class="text-2xl font-bold mb-4">Cek Status Laporan</h1>
<form action="/cek" method="GET" class="flex gap-2 mb-4">
  <input name="ticket" placeholder="BLY-0001-XXXX" class="flex-1 border rounded p-2 font-mono">
  <button class="bg-blue-700 text-white px-4 rounded">Cek</button>
</form>
<% if (error) { %><div class="bg-red-100 text-red-800 p-3 rounded"><%= error %></div><% } %>
<% if (result) { %>
<div class="bg-white p-4 rounded shadow space-y-2">
  <div class="font-mono font-bold"><%= result.ticket_code %></div>
  <div>Kategori: <b><%= result.kategori %></b></div>
  <div>Status: <span class="bg-blue-100 px-2 py-1 rounded"><%= result.status %></span></div>
  <div>Urgensi: <b><%= result.urgensi || '-' %></b></div>
  <div class="text-sm text-slate-600"><%= result.ringkasan %>…</div>
  <div class="flex gap-1 mt-2 text-xs">
    <% ['Diterima','Diverifikasi','Diproses','Selesai'].forEach(s => { %>
      <span class="px-2 py-1 rounded <%= result.status===s?'bg-green-600 text-white':'bg-slate-200' %>"><%= s %></span>
    <% }) %>
  </div>
</div>
<% } %>
<%- include('_foot') %>
