<%- include('_head', { title: 'Cek Tiket' }) %>
<h1 class="text-2xl font-extrabold mb-4">Cek Status Laporan</h1>
<form action="/cek" method="GET" class="flex gap-2 mb-4">
  <input name="ticket" placeholder="BLY-0001-XXXX" value="<%= typeof ticket !== 'undefined' ? ticket : '' %>" class="flex-1 border rounded-xl p-3 font-mono min-h-[44px]">
  <button class="bg-blue-700 hover:bg-blue-800 transition text-white font-bold px-5 rounded-xl min-h-[44px]">Cek</button>
</form>
<% if (error) { %><div class="bg-red-100 text-red-800 p-3 rounded-xl"><%= error %></div><% } %>
<% if (result) { %>
<div class="bg-white p-5 rounded-2xl shadow space-y-2">
  <div class="font-mono font-bold text-lg"><%= result.ticket_code %></div>
  <div class="text-sm">Kategori: <b><%= result.kategori %></b> · Urgensi: <b><%= result.urgensi || '-' %></b></div>
  <div class="text-sm text-slate-600"><%= result.ringkasan %>…</div>
  <ol class="mt-3 space-y-0">
    <% const steps = ['Diterima','Diverifikasi','Diproses','Selesai']; const cur = steps.indexOf(result.status); %>
    <% steps.forEach((s, i) => { %>
      <li class="flex gap-3">
        <div class="flex flex-col items-center">
          <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold <%= i < cur ? 'bg-green-600 text-white' : i === cur ? 'bg-blue-700 text-white' : 'bg-slate-200 text-slate-500' %>"><%= i < cur ? '✓' : (i + 1) %></span>
          <% if (i < steps.length - 1) { %><span class="w-0.5 flex-1 <%= i < cur ? 'bg-green-600' : 'bg-slate-200' %>"></span><% } %>
        </div>
        <div class="pb-5">
          <div class="font-semibold text-sm <%= i === cur ? '' : 'text-slate-500' %>"><%= s %></div>
          <% if (i === cur) { %><div class="text-xs text-blue-700 font-semibold">Posisi laporanmu</div><% } %>
        </div>
      </li>
    <% }) %>
  </ol>
</div>
<% } %>
<%- include('_foot') %>
