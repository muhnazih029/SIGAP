<%- include('_head', { title: 'Ganti Password' }) %>
<h1 class="text-2xl font-bold mb-4">Ganti Password</h1>
<% if (error) { %><div class="bg-red-100 text-red-800 p-3 rounded mb-4"><%= error %></div><% } %>
<% if (ok) { %><div class="bg-green-100 text-green-800 p-3 rounded mb-4"><%= ok %></div><% } %>
<form action="/admin/password" method="POST" class="bg-white p-4 rounded shadow space-y-3">
  <input name="current" type="password" placeholder="Password lama" required class="w-full border rounded p-2">
  <input name="next" type="password" placeholder="Password baru (min 8)" required minlength="8" class="w-full border rounded p-2">
  <button class="bg-blue-700 text-white px-4 py-2 rounded w-full">Simpan</button>
</form>
<%- include('_foot') %>
