<%- include('_head', { title: 'Dashboard' }) %>
<div class="flex justify-between items-center mb-4 flex-wrap gap-2">
  <h1 class="text-2xl font-extrabold">Dashboard <span id="badge" class="text-xs bg-red-600 text-white px-2 py-1 rounded-full align-middle"><%= unread %> baru</span></h1>
</div>
<div class="flex gap-2 mb-3">
  <input id="q" placeholder="Cari tiket…" class="flex-1 border rounded-xl p-3 font-mono min-w-0">
  <label class="relative flex items-center">
    <svg class="w-5 h-5 absolute left-3 text-slate-500 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M7 12h10M10 19h4"/></svg>
    <select id="statusFilter" class="appearance-none border rounded-xl pl-10 pr-8 py-3 bg-white font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <% ['Semua','Diterima','Diverifikasi','Diproses','Selesai'].forEach(s => { %>
        <option value="<%= s %>" <%= filter===s?'selected':'' %>><%= s %></option>
      <% }) %>
    </select>
  </label>
</div>
<div class="bg-white rounded-2xl shadow overflow-hidden">
<table class="w-full text-sm">
  <thead class="bg-slate-50 text-left text-xs text-slate-500">
    <tr><th class="p-3">Tiket</th><th class="p-3">Kategori</th><th class="p-3">Status</th><th class="p-3">Urgensi</th></tr>
  </thead>
  <tbody id="rows">
  <% const urgColor = {Ringan:'bg-green-100 text-green-800',Sedang:'bg-yellow-100 text-yellow-800',Berat:'bg-red-100 text-red-800'}; %>
  <% reports.forEach(r => { %>
    <tr class="border-t hover:bg-blue-50" data-ticket="<%= r.ticket_code %>">
      <td class="p-3"><a href="/admin/<%= r.ticket_code %>" class="font-mono font-bold text-blue-700"><%= r.ticket_code %></a></td>
      <td class="p-3"><%= r.kategori %></td>
      <td class="p-3"><span class="text-xs bg-slate-200 px-2 py-1 rounded-full"><%= r.status %></span></td>
      <td class="p-3"><% if (r.urgensi) { %><span class="text-xs px-2 py-1 rounded-full <%= urgColor[r.urgensi]||'bg-slate-200' %>"><%= r.urgensi %></span><% } else { %>-<% } %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% if (!reports.length) { %><p class="text-slate-500 p-4 text-sm">Belum ada laporan.</p><% } %>
</div>
<script>
document.getElementById('statusFilter').addEventListener('change', (e) => {
  const v = e.target.value;
  window.location = '/admin' + (v === 'Semua' ? '' : '?status=' + v);
});
document.getElementById('q').addEventListener('input', (e) => {
  const q = e.target.value.toUpperCase();
  document.querySelectorAll('#rows tr').forEach(tr => {
    tr.style.display = tr.dataset.ticket.includes(q) ? '' : 'none';
  });
});
setInterval(async () => {
  try {
    const r = await fetch('/admin/unread-count'); const j = await r.json();
    document.getElementById('badge').textContent = j.count + ' baru';
  } catch {}
}, 15000);
</script>
<%- include('_foot') %>
