<%- include('_head', { title: 'Login Admin' }) %>
<h1 class="text-2xl font-bold mb-4">Login Admin (Guru BK)</h1>
<% if (error) { %><div class="bg-red-100 text-red-800 p-3 rounded mb-4"><%= error %></div><% } %>
<form action="/admin/login" method="POST" class="bg-white p-4 rounded shadow space-y-3">
  <input name="username" placeholder="Username" required class="w-full border rounded p-2">
  <input name="password" type="password" placeholder="Password" required class="w-full border rounded p-2">
  <button class="bg-blue-700 text-white px-4 py-2 rounded w-full">Masuk</button>
</form>
<%- include('_foot') %>
