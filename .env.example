# SIGAP - Sistem Informasi Gerakan Anti Penindasan
# Ganti sesuai environment (STB lokal / Supabase)

PORT=3000
DATABASE_URL=postgres://sigap:changeme@localhost:5432/sigap
SESSION_SECRET=ganti-secret-min-32-karakter

# Local Postgres (docker compose). Defaults match DATABASE_URL above.
# Override in real `.env` for STB/prod. Never commit `.env`.
# NOTE: `changeme` is an intentional non-secret placeholder (scanner-ignored).
POSTGRES_USER=sigap
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sigap
POSTGRES_PORT=5432

# Untuk Supabase Storage (opsional, kalau gambar offload)
# SUPABASE_URL=
# SUPABASE_KEY=

# Tiket: secure (BLY-0001-K7Q9) default, sequential (BLY-0001) kalau client minta polos
TICKET_MODE=secure

# Notifikasi Telegram admin (kosong = skip, submit tetap sukses)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
